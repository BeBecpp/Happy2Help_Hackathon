{
  "name": "happy2help_api",
  "version": "0.1.0",
  "private": true,
  "description": "Happy2Help erxes plugin (platform stack: erxes-api-shared startPlugin + tenant-scoped Mongoose models)",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env --env-file-if-exists=../.env.runtime src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env --env-file-if-exists=../.env.runtime dist/main.js",
    "check": "tsc --noEmit",
    "schema:print": "tsx src/print-schema.ts",
    "seed": "tsx --env-file-if-exists=../.env --env-file-if-exists=../.env.runtime src/scripts/seed.ts",
    "ai:verify": "tsx --env-file-if-exists=../.env --env-file-if-exists=../.env.runtime src/scripts/verify-ai.ts",
    "ai:diag": "tsx --env-file-if-exists=../.env --env-file-if-exists=../.env.runtime src/scripts/diag-openrouter.ts",
    "ai:eval": "tsx --env-file-if-exists=../.env --env-file-if-exists=../.env.runtime src/scripts/eval-ai.ts",
    "test": "tsx --test src/tests/unit/*.test.ts",
    "test:e2e": "tsx --test --test-concurrency=1 --test-timeout=180000 src/tests/e2e/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "erxes-api-shared": "npm:@erxes/api-shared@3.3.4",
    "graphql": "^16.14.2",
    "graphql-tag": "^2.12.7",
    "mongoose": "^8.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@apollo/subgraph": "^2.15.1",
    "@types/node": "^22.20.4",
    "mongodb-memory-server": "^10.2.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
