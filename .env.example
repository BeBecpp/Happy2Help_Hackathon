# ───────────── erxes plugin (api/) ─────────────
NODE_ENV=development
# PORT=3399                      # overrides api.port from erxes.json
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# Same MongoDB the erxes stack uses (plugin collections are prefixed happy2help_).
MONGO_URL=mongodb://localhost:27017/erxes?directConnection=true
# Address the erxes gateway uses to reach this plugin (unset = localhost in dev, plugin-happy2help-api in prod).
# LOAD_BALANCER_ADDRESS=http://localhost:3399
# RELEASE_VERSION=

# HMAC secret for school-location QR codes (>= 16 chars). `node tools/dev-stack.mjs` generates one.
HAPPY2HELP_QR_SECRET=change-me-to-a-long-random-string
# Tenant (erxes subdomain) the demo seed writes to. Local dev: localhost.
HAPPY2HELP_TENANT=localhost

# ───────────── Happy AI · Gemma 4 via OpenRouter ─────────────
# Leave the key empty to run WITHOUT AI: SOS, response and chat are unchanged; analyses are stored as SKIPPED.
# Never commit a real key. Server-side only (the browser never sees it).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Paid slug needs OpenRouter credits; the :free slug works on a free key but is often rate-limited upstream.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it
# Gemma 4 slugs tried in order on 402/429/503 (default shown):
# HAPPY_AI_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it,google/gemma-4-31b-it
HAPPY_AI_PROVIDER=openrouter        # openrouter (Gemma 4) | anthropic (Claude)
# Anthropic Claude alternative (HAPPY_AI_PROVIDER=anthropic). Model id from GET /v1/models.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
HAPPY_AI_TIMEOUT_MS=25000
HAPPY_AI_MAX_CALLS_PER_PROCESS=500      # hard safety cap per plugin process

# ───────────── Web app (web/) ─────────────
# dev-direct = laptop without erxes gateway (labelled fictional personas, talks to the plugin's own /graphql)
# gateway    = real erxes: logins go through ERXES_GRAPHQL_URL, which forwards identity to the plugin
H2H_MODE=dev-direct
H2H_PLUGIN_GRAPHQL_URL=http://localhost:3399/graphql
# ERXES_GRAPHQL_URL=https://<erxes-host>/gateway/graphql
# ERXES_CP_ID=<client portal id for student logins>
# ERXES_CP_APP_TOKEN=<client portal app token>
# >= 32 random chars; signs the HttpOnly session cookie. `node tools/dev-stack.mjs` generates one.
H2H_SESSION_SECRET=change-me-to-at-least-32-random-characters
